# Configuración de Faro. Copia este archivo como "faro.env" (junto al
# ejecutable o en la carpeta desde donde lo ejecutas) y completa los datos.
# Las variables de entorno FARO_* tienen prioridad sobre este archivo.

# Destinatario de las notificaciones (por defecto ya es este correo).
FARO_NOTIFY_TO=joanromana.st@academia.umb.edu.co

# Cuenta que ENVÍA los correos. Ejemplo con Gmail:
#   1. Activa la verificación en dos pasos en la cuenta.
#   2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. Pega esa contraseña de 16 caracteres abajo (no tu contraseña normal).
# Con Outlook/Office 365 usa FARO_SMTP_HOST=smtp.office365.com y puerto 587.
FARO_SMTP_HOST=smtp.gmail.com
FARO_SMTP_PORT=587
FARO_SMTP_USER=tu.cuenta@gmail.com
FARO_SMTP_PASSWORD=
FARO_SMTP_FROM=Faro <tu.cuenta@gmail.com>

# Ruta opcional de la base de datos SQLite.
# Por defecto: ~/.local/share/faro/faro.db (Linux), %APPDATA%\faro\faro.db (Windows),
# ~/Library/Application Support/faro/faro.db (macOS).
# FARO_DB_PATH=faro.db
